{
  "name": "algoky",
  "version": "2.0.0",
  "private": true,
  "description": "Plataforma de estudos de DSA e LeetCode com trilha de padrões, revisão espaçada e gamificação.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run dev --workspace @algoky/api & npm run dev --workspace @algoky/web; wait",
    "dev:api": "npm run dev --workspace @algoky/api",
    "dev:web": "npm run dev --workspace @algoky/web",
    "build": "npm run build --workspace @algoky/web && npm run build --workspace @algoky/api",
    "start": "npm run start --workspace @algoky/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaioRenatoDot/Algoky.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
