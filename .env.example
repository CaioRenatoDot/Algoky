# Porta publicada no host
PORT=3333

# Deixe true para criar sua conta e depois mude para false para fechar a instância
ALLOW_REGISTRATION=true

# true quando estiver atrás de HTTPS (proxy reverso); obrigatório em produção pública
COOKIE_SECURE=false

# Tentativas de login/cadastro por IP por minuto
AUTH_RATE_LIMIT=20

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
